# .coi.toml — drop-in configuration for code-on-incus
#
# Copy this file to <project>/.coi.toml (dotfile at repo root, NOT
# <project>/.coi/config.toml — coi only auto-discovers $CWD/.coi.toml,
# ~/.config/coi/config.toml, /etc/coi/config.toml, or $COI_CONFIG).
# Verify with: `coi health` — must report `Config loaded: <path>`.
#
# Schema reference: `coi shell --help`, `coi health`, upstream README.

[tool]
# Which coding agent to launch. "claude" (default), "opencode", "aider".
name = "claude"
# "bypass" is equivalent to --dangerously-skip-permissions. The whole
# point of COI is to run in bypass mode safely — set to "normal" only if
# you specifically want per-tool approval prompts.
permission_mode = "bypass"

[ssh]
# Forward the host's SSH agent via an Incus proxy device.
# The Makefile targets (coi / coi-ssh-fix) attach the proxy and set
# the host and container socket paths. This flag tells the tool inside
# the container to use the forwarded socket.
forward_agent = true

[network]
# "restricted" (default) — allowlist: api.anthropic.com, common
#   package registries, git hosts. Arbitrary egress blocked.
# "open" — unrestricted egress. Use only when the agent needs
#   unknown domains (scraping, rotating-endpoint APIs, WebRTC).
mode = "restricted"

[monitoring]
# Kernel-level threat detection with automatic container pause on
# suspicious patterns. Leave enabled. Disabling is a security smell.
enabled = true

[environment]
# Tells tools inside the container where to find the forwarded agent.
# Must match the `listen=` path used by the proxy device in the Makefile.
SSH_AUTH_SOCK = "/tmp/ssh-auth.sock"
# Add project-specific env vars here. Do NOT paste secrets into a
# committed config — prefer `coi shell --env KEY=VALUE` or a .env
# file loaded by the project itself.

[defaults]
# true  — container state (shell history, installed packages, in-progress
#         agent sessions) survives across `coi shell` invocations. Best
#         for daily-driver projects.
# false — ephemeral: container destroyed on exit. Best for untrusted
#         projects or one-off tasks. `claude update` etc. won't persist.
persistent = true

# Optional: per-project resource limits.
# [limits]
# memory    = "8GiB"
# cpu       = "4"
# duration  = "4h"

# Bind mounts into the container. Applied at container CREATION only —
# if `[defaults] persistent = true` and the container already exists,
# edits here have no effect until `make coi-clean` destroys it.
#
# UID shift is on by default (see [incus] disable_shift), so files on
# the host show as owned by the container's `code` user (uid 1000)
# regardless of host ownership — fixes the classic `nobody:nogroup` /
# Operation-not-permitted failure on bind-mounted paths.
#
# Fields: host (supports `~`), container (absolute path), readonly (optional).
# NEVER mount ~/.ssh or the full $HOME. See security invariants in the skill.
[[mounts.default]]
host = "~/.claude/projects"              # Claude history persists across containers
container = "/home/code/.claude/projects"

[[mounts.default]]
host = "~/.claude/skills"
container = "/home/code/.claude/skills"

# Example project-specific mount — delete or adapt:
# [[mounts.default]]
# host = "/path/on/host/shared-cache"
# container = "/workspace/cache"
# readonly = true

# Optional: disable UID shift if on Colima/Lima (auto-detected there
# anyway via virtiofs probe) or when idmapped mounts aren't supported.
# [incus]
# disable_shift = false